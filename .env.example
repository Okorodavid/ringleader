# FalkorDB connection. Any of: local Docker, self-hosted, or FalkorDB Cloud (free tier).
# Docker:  docker run -p 6379:6379 -it --rm falkordb/falkordb:latest
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=ringleader

# Investigator provider: gemini (free tier key) | rules (offline, deterministic, no key needed)
PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Server
PORT=8000
